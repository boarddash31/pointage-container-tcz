# ==============================================================================
# CONFIGURATION GLOBALE - TCZ POINTAGE CONTENEUR
# Copiez ce fichier vers .env et remplissez vos identifiants Cloudflare / Netlify
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Base de données, Auth & RPC)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://iparzfqxopcvwqelxlad.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_AgyGT1cfJz9gkXTpVrLsXg_B3VNWHGs

# ------------------------------------------------------------------------------
# 2. NOM DE DOMAINE & URLS DE PRODUCTION
# ------------------------------------------------------------------------------
CUSTOM_DOMAIN=marsa.digital
AUTH_SITE_URL=https://marsa.digital

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE PAGES (Hébergement CDN mondial & SSL automatique)
# ------------------------------------------------------------------------------
# Cloudflare Dashboard > Workers & Pages > Volet de droite: "Account ID"
CLOUDFLARE_ACCOUNT_ID=VOTRE_ACCOUNT_ID_ICI

# Cloudflare Dashboard > Mon profil > API Tokens > Create Token > "Cloudflare Pages: Edit"
CLOUDFLARE_API_TOKEN=VOTRE_CLOUDFLARE_API_TOKEN_ICI

# Nom du projet Pages sur Cloudflare
CLOUDFLARE_PROJECT_NAME=pointage-container-tcz

# ------------------------------------------------------------------------------
# 4. NETLIFY (Hébergement de secours & redondance active)
# ------------------------------------------------------------------------------
# Optional. Keep the personal access token in an ignored .env file.
NETLIFY_AUTH_TOKEN=

# Netlify Site ID
NETLIFY_SITE_ID=4f8fd024-ea53-4a85-83c0-faeac73a04f6

# URL Netlify actuelle
NETLIFY_URL=https://pointage-tcz-test.netlify.app
